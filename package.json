{
  "name": "inertia-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root for @rootnative/inertia — a wrapper around react-native-reanimated that makes the animation system easier.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "example": "pnpm --filter @rootnative/inertia-example start",
    "example:ios": "pnpm --filter @rootnative/inertia-example ios",
    "example:android": "pnpm --filter @rootnative/inertia-example android",
    "docs:dev": "pnpm --filter @rootnative/inertia-docs dev",
    "docs:build": "turbo run build --filter=@rootnative/inertia-docs",
    "docs:check": "pnpm --filter @rootnative/inertia-docs build:check",
    "docs:serve": "pnpm --filter @rootnative/inertia-docs serve",
    "build:brand": "node scripts/build-brand.mjs",
    "build:llms": "node scripts/build-llms.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:versions:fix": "node scripts/check-versions.mjs --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
